# --- App ---
JWT_SECRET=change-me-to-a-long-random-string

# --- MySQL ---
DATABASE_URL=mysql+pymysql://root:knowbase_dev@localhost:3306/knowbase?charset=utf8mb4

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- LLM (OpenAI 兼容接口，可切换 DeepSeek/GLM/Qwen/SiliconFlow) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# --- Embedding (OpenAI 兼容接口，如 SiliconFlow 的 BAAI/bge-m3) ---
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- 切片 / 检索 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
